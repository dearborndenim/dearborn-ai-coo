# Database (shared PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/dearborn

# Redis for event bus
REDIS_URL=redis://default:pass@host:6379

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://dearborn-ai-cmo-production.up.railway.app

# Shopify OAuth (for finished goods sync)
SHOPIFY_STORE=dearborndenim.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
# SHOPIFY_ACCESS_TOKEN is stored in database after OAuth

# Other module URLs (Railway internal networking)
CEO_API_URL=http://ceo-api.railway.internal:8080
CFO_API_URL=http://quickbooks-sync.railway.internal:8080
CDO_API_URL=http://dearborn-ai-cdo.railway.internal:8080
CMO_API_URL=http://dearborn-ai-cmo.railway.internal:3000

# Inventory thresholds
DEFAULT_REORDER_POINT=10
LOW_STOCK_THRESHOLD=5
